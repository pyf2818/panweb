def pin_file_path(entry_id):
    return os.path.join(SECRETS_DIR, "%s.pin" % entry_id)


def read_pin(entry_id):
    try:
        with open(pin_file_path(entry_id), "r", encoding="utf-8") as f:
            pin = f.read().strip()
            return pin or None
    except OSError:
        return None


def write_pin(entry_id, pin):
    os.makedirs(SECRETS_DIR, exist_ok=True)
    if pin:
        with open(pin_file_path(entry_id), "w", encoding="utf-8") as f:
            f.write(pin)
    else:
        try:
            os.remove(pin_file_path(entry_id))
        except OSError:
            pass


def pin_token(entry_id, pin):
    return hashlib.sha256(("%s:%s" % (entry_id, pin)).encode()).hexdigest()[:32]


def log_visit(entry_id, path, ip, ua):
    """记录一次访问（JSONL 追加，UV 用 ip 哈希）。"""
    try:
        os.makedirs(VISITS_DIR, exist_ok=True)
        rec = {"ts": time.time(), "path": path[:120],
               "ip": hashlib.sha256(ip.encode()).hexdigest()[:12],
               "ua": (ua or "")[:80]}
        with open(os.path.join(VISITS_DIR, "%s.jsonl" % entry_id), "a",
                  encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except OSError:
        pass


def _ua_device(ua):
    ua = (ua or "").lower()
    if "ipad" in ua or "tablet" in ua:
        return "平板"
    if "mobile" in ua or "iphone" in ua or "android" in ua:
        return "移动端"
    return "桌面端"


def aggregate_visits(entry_id, hours=24, recent=15):
    """聚合访问记录 → {total, uv, points, last, recent, devices}。

    24 小时按小时分桶，超过 48 小时按天分桶。
    """
    path = os.path.join(VISITS_DIR, "%s.jsonl" % entry_id)
    since = time.time() - hours * 3600
    total, ips, points, last, recents, devices = 0, set(), {}, None, [], {}
    bucket = 3600 if hours <= 48 else 86400
    start = int(since // bucket) * bucket
    n_buckets = int(hours * 3600 // bucket)
    try:
        with open(path, "r", encoding="utf-8") as f:
            for line in f:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                ts = rec.get("ts", 0)
                if ts >= since:
                    total += 1
                    ips.add(rec.get("ip"))
                    key = int(ts // bucket) * bucket
                    points[key] = points.get(key, 0) + 1
                    last = max(last or 0, ts)
                    recents.append(rec)
                    dev = _ua_device(rec.get("ua"))
                    devices[dev] = devices.get(dev, 0) + 1
    except OSError:
        pass
    recents.sort(key=lambda r: -r.get("ts", 0))
    for r in recents:
        r["device"] = _ua_device(r.get("ua"))
    series = [{"t": start + i * bucket, "count": points.get(start + i * bucket, 0)}
              for i in range(n_buckets)]
    return {"total": total, "uv": len(ips), "points": series, "last": last,
            "recent": recents[:recent], "devices": devices, "hours": hours}


