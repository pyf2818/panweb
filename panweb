# Node dev server 常见端口（日志嗅探不到时的兜底探测顺序）
NODE_DEV_PORTS = [3000, 3001, 5173, 5174, 4321, 1420, 8000, 8080, 8888]
PORT_HINT_RE = re.compile(
    r"(?:localhost|127\.0\.0\.1|0\.0\.0\.0|::1?|\[[^\]]+\]):(\d{2,5})", re.I)


def core_detect(folder):
    folder = os.path.abspath(os.path.expanduser(folder or ""))
    if not os.path.isdir(folder):
        raise PanwebError(2, "invalid_argument", "文件夹不存在：%s" % folder)
    pkg_path = os.path.join(folder, "package.json")
    if os.path.isfile(pkg_path):
        try:
            with open(pkg_path, "r", encoding="utf-8") as f:
                pkg = json.load(f)
            scripts = pkg.get("scripts") or {}
            script = "dev" if "dev" in scripts else ("start" if "start" in scripts else None)
            if script:
                return {"type": "node", "script": script, "folder": folder,
                        "detail": "识别到 Node 项目（npm run %s）" % script}
            return {"type": "node", "script": None, "folder": folder,
                    "detail": "Node 项目缺少 dev/start 脚本，无法自动启动"}
        except ValueError:
            pass
    if os.path.isfile(os.path.join(folder, "index.html")):
        return {"type": "static", "folder": folder, "detail": "识别到静态网页（直接发布）"}
    try:
        if any(f.endswith(".py") for f in os.listdir(folder)):
            return {"type": "python", "folder": folder,
                    "detail": "Python 项目：请手动启动后到「发布端口」选择"}
    except OSError:
        pass
    return {"type": "unknown", "folder": folder,
            "detail": "未识别的项目类型：可手动启动后到「发布端口」选择"}


def _sniff_port(log_path):
    """从项目启动日志里嗅探监听端口（必须是当前确实在监听的）。"""
    try:
        with open(log_path, "rb") as f:
            text = f.read().decode("utf-8", "replace")
    except OSError:
        return None
    for m in PORT_HINT_RE.finditer(text):
        try:
            p = int(m.group(1))
        except ValueError:
            continue
        if 1024 <= p <= 65535 and port_listening(p):
            return p
    return None


def core_run(folder, name=None):
    """识别项目类型 → 自动启动 → 等端口就绪 → 发布。"""
    info = core_detect(folder)
    folder = info["folder"]
    if info["type"] == "static":
        entry = core_pages(folder, name)
        log_activity("publish", "识别为静态网页，直接发布了「%s」" % entry["name"], entry["url"])
        return entry
    if info["type"] != "node" or not info.get("script"):
        raise PanwebError(2, "unsupported", info["detail"],
                          "可手动启动应用后用「发布端口」发布")
    npm = shutil.which("npm")
    if not npm:
        raise PanwebError(3, "dependency_missing", "未找到 npm",
                          "安装 Node.js 后重试")

    os.makedirs(LOG_DIR, exist_ok=True)
    app_log = os.path.join(LOG_DIR, "run-%s.log" % uuid.uuid4().hex[:6])
    logf = open(app_log, "ab", buffering=0)
    try:
        proc = subprocess.Popen([npm, "run", info["script"]], cwd=folder,
                                stdout=logf, stderr=subprocess.STDOUT,
                                stdin=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        logf.close()
        raise PanwebError(9, "app_start_failed", "无法启动项目：%s" % e)
    logf.close()

    # 等待项目监听端口：先嗅探日志，再兜底探测常见端口
    port = None
    deadline = time.time() + 120
    while time.time() < deadline:
        if proc.poll() is not None:
            raise PanwebError(9, "app_start_failed",
                              "项目进程提前退出（码 %s）" % proc.returncode,
                              "查看日志：%s" % app_log)
        port = _sniff_port(app_log)
        if not port:
            for p in NODE_DEV_PORTS:
                if port_listening(p):
                    port = p
                    break
        if port:
            break
        time.sleep(1)
    if not port:
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
        except OSError:
            pass
        raise PanwebError(9, "app_start_failed", "120 秒内没有检测到项目监听的端口",
                          "查看日志：%s；也可手动启动后用「发布端口」" % app_log)

    entry = _publish_port(port, name or os.path.basename(folder),
                          extra={"app_pid": proc.pid, "app_log": app_log, "launched": True})
    log_activity("publish", "启动并发布了「%s」（npm run %s，端口 %d）"
                 % (entry["name"], info["script"], port), entry["url"])
    return entry


def core_pages(folder, name=None, pin=None, expires=None):
    folder = os.path.abspath(os.path.expanduser(folder))
    if not os.path.isdir(folder):
        raise PanwebError(2, "invalid_argument", "文件夹不存在：%s" % folder)
    entry = _publish_port(0, name or os.path.basename(folder),
                          extra={"kind": "pages", "target": folder},
                          pin=pin, serve_dir=folder,
                          expires_at=parse_expires(expires))
    log_activity("publish", "发布了网页「%s」%s" % (entry["name"],
                 "（已设置访问口令）" if pin else ""), entry["url"])
    return entry


def core_list():
    """全部发布条目（不做死亡清理——死亡条目由健康监控自愈，stop 才移除）。"""
    entries = load_state()
    for e in entries:
        e["alive"] = pid_alive(e.get("pid")) or pid_alive(e.get("server_pid"))
    return entries


def core_stop(target):
    entries = load_state()
    if target == "all":
        hits = list(entries)
    else:
        hits = [e for e in entries if target in (e["id"], e["name"], e["url"])]
    if not hits:
        raise PanwebError(2, "not_found", "没有找到匹配「%s」的发布" % target,
                          "用 panweb list 查看已发布的应用")
    stopped = []
    for e in hits:
        stop_entry(e)
        stopped.append({"id": e["id"], "name": e["name"], "url": e["url"]})
        log_activity("stop", "停止了「%s」" % e["name"], e["url"])
    remaining = [e for e in load_state() if e not in hits]
    save_state(remaining)
    meta = load_meta()
    meta["stopped_total"] = meta.get("stopped_total", 0) + len(stopped)
    save_json(META_FILE, meta)
    write_menubar_state()
    return stopped


def core_stats():
    apps = core_list()
    meta = load_meta()
    attention = [a for a in apps if a.get("risky")]
    return {
        "total": len(apps),
        "online": sum(1 for a in apps if a.get("alive")),
        "stopped_total": meta.get("stopped_total", 0),
        "attention": len(attention),
        "attention_items": [{"id": a["id"], "name": a["name"], "risky": a["risky"]}
                            for a in attention],
    }


