def _spawn_proxy(listen_port, entry_id, target_port=None, serve_dir=None,
                 pin=None):
    """启动内置代理子进程（pin 校验 + 访问统计 + 静态/转发），返回进程。"""
    write_pin(entry_id, pin)
    script = os.path.realpath(__file__)
    logf = open(os.path.join(LOG_DIR, "%s-proxy.log" % entry_id), "ab", buffering=0)
    cmd = [sys.executable, script, "--internal-proxy",
           "--listen-port", str(listen_port), "--entry-id", entry_id]
    if serve_dir:
        cmd += ["--serve-dir", serve_dir]
    else:
        cmd += ["--target-port", str(target_port)]
    try:
        proc = subprocess.Popen(cmd, stdout=logf, stderr=subprocess.STDOUT,
                                stdin=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        proc = None
    logf.close()
    return proc


def _publish_port(port, name, extra=None, pin=None, serve_dir=None, expires_at=None):
    """发布端口的共用实现（CLI / API / run 共用），返回带可达性信息的条目。

    设置 pin 或 serve_dir 时经由内置代理（隧道指向代理端口，改口令无需换网址）；
    预热池可用时直接取隧道（秒级发布）。
    """
    cf = find_cloudflared()
    if not cf:
        raise PanwebError(3, "dependency_missing", "未找到 cloudflared",
                          "先安装：brew install cloudflared")
    os.makedirs(LOG_DIR, exist_ok=True)
    entry_id = uuid.uuid4().hex[:6]
    entry_extra = {"pinned": bool(pin)}

    if pin or serve_dir:
        proxy_port = free_port()
        proxy_proc = _spawn_proxy(proxy_port, entry_id,
                                  target_port=None if serve_dir else port,
                                  serve_dir=serve_dir, pin=pin)
        if not proxy_proc:
            raise PanwebError(9, "server_failed", "无法启动内置代理进程")
        deadline = time.time() + 6
        while time.time() < deadline and not port_listening(proxy_port):
            time.sleep(0.2)
        if not port_listening(proxy_port):
            try:
                os.killpg(os.getpgid(proxy_proc.pid), signal.SIGTERM)
            except OSError:
                pass
            raise PanwebError(9, "server_failed", "内置代理启动失败",
                              "查看日志：%s" % os.path.join(LOG_DIR, "%s-proxy.log" % entry_id))
        entry_extra["proxy_port"] = proxy_port
        entry_extra["server_pid"] = proxy_proc.pid
        tunnel_target = proxy_port
    else:
        tunnel_target = port

    item = acquire_pooled_tunnel(tunnel_target, entry_id) if CURRENT_POOL else None
    if item:
        url, pid = item["url"], item["pid"]
        entry_extra["pooled"] = True
    else:
        log_path = os.path.join(LOG_DIR, "%s.log" % entry_id)
        try:
            url, proc = start_tunnel(cf, tunnel_target, log_path)
        except TunnelError as e:
            raise PanwebError(9, "tunnel_failed", str(e),
                              "查看日志：%s" % log_path)
        pid = proc.pid

    entry = {
        "id": entry_id,
        "name": name or ("port-%d" % port),
        "kind": "port",
        "target": port,
        "url": url,
        "pid": pid,
        "risky": is_risky_port(port),
        "started": time.strftime("%Y-%m-%d %H:%M:%S"),
    }
    if expires_at:
        entry_extra["expires_at"] = expires_at
    if extra:
        entry.update(extra)
    entry.update(entry_extra)
    register_entry(entry)
    write_menubar_state()
    reachable, dns_slow = verify_public(url)
    return dict(entry, reachable=reachable, dns_slow=dns_slow)


def core_publish(port, name=None, pin=None, expires=None):
    try:
        port = int(port)
    except (TypeError, ValueError):
        raise PanwebError(2, "invalid_argument", "端口必须是数字")
    if not (1 <= port <= 65535):
        raise PanwebError(2, "invalid_argument", "端口必须在 1-65535 之间")
    if not port_listening(port):
        raise PanwebError(8, "port_not_serving", "端口 %d 上没有正在运行的程序" % port,
                          "先在本地启动应用（或到「启动项目」让 panweb 替你启动），再发布")
    entry = _publish_port(port, name, pin=pin, expires_at=parse_expires(expires))
    log_activity("publish", "发布了应用「%s」%s" % (entry["name"],
                 "（已设置访问口令）" if pin else ""), entry["url"])
    return entry


