def pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def prune_state():
    """移除进程已死的条目。"""
    entries = [e for e in load_state() if pid_alive(e.get("pid"))]
    save_state(entries)
    return entries


def find_cloudflared():
    for c in CLOUDFLARED_CANDIDATES:
        path = shutil.which(c) if not os.path.isabs(c) else (c if os.path.isfile(c) and os.access(c, os.X_OK) else None)
        if path:
            return path
    return None


def port_listening(port, host="127.0.0.1"):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.5)
        return s.connect_ex((host, port)) == 0


def free_port():
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


# ---------- 隧道核心 ----------

def start_tunnel(cf_bin, local_port, log_path):
    """启动 cloudflared 快速隧道，返回 (公网网址, 进程)。失败抛 TunnelError。"""
    logf = open(log_path, "ab", buffering=0)
    try:
        proc = subprocess.Popen(
            [cf_bin, "tunnel", "--url", "http://127.0.0.1:%d" % local_port,
             "--no-autoupdate"],
            stdout=logf, stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL, start_new_session=True,
        )
    except OSError as e:
        logf.close()
        raise TunnelError("无法启动 cloudflared：%s" % e)

    url = None
    deadline = time.time() + 30
    buf = b""
    while time.time() < deadline:
        if proc.poll() is not None:
            logf.close()
            raise TunnelError("cloudflared 提前退出（码 %s）\n%s" % (proc.returncode, read_log_tail(log_path)))
        try:
            with open(log_path, "rb") as f:
                f.seek(len(buf))
                buf += f.read()
            m = TUNNEL_URL_RE.search(buf.decode("utf-8", "replace"))
            if m:
                url = m.group(0)
                break
        except OSError:
            pass
        time.sleep(0.4)
    logf.close()
    if not url:
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
        except OSError:
            pass
        tail = read_log_tail(log_path)
        if "429" in tail:
            raise TunnelError("Cloudflare 限流（429）：短期创建的快速隧道太多，请稍后再试；"
                              "或在「系统与数据」配置固定域名（不限流、网址永久）")
        raise TunnelError("等待隧道网址超时（30 秒）\n%s" % tail)
    return url, proc


class TunnelError(Exception):
    pass


def read_log_tail(log_path, n=800):
    try:
        with open(log_path, "rb") as f:
            return f.read()[-n:].decode("utf-8", "replace")
    except OSError:
        return ""


def _direct_check(url, timeout):
    """直接访问：任何 HTTP 响应（含 5xx）都算通。"""
    try:
        req = urllib.request.Request(url, method="GET")
        urllib.request.urlopen(req, timeout=timeout)
        return True
    except urllib.error.HTTPError:
        return True
    except Exception:
        return False


def _pinned_check(url, timeout):
    """边缘 IP 直连：用 trycloudflare.com 的边缘 IP + SNI 验证全链路，绕开本地 DNS。"""
    try:
        host = url.split("//", 1)[-1].split("/", 1)[0]
        edge = socket.getaddrinfo("trycloudflare.com", 443, socket.AF_INET)[0][4][0]
        out = subprocess.run(
            ["curl", "-s", "--resolve", "%s:443:%s" % (host, edge),
             "-o", "/dev/null", "-w", "%{http_code}", "--max-time", str(timeout), url],
            capture_output=True, text=True, timeout=timeout + 5,
        ).stdout.strip()
        return bool(out) and out != "000"
    except Exception:
        return False


def verify_public(url, timeout=15):
    """公网可达性验证，返回 (reachable, dns_slow)。

    立即查询新子域名可能把本地 DNS 打成负缓存，所以先等 3 秒，
    用边缘 IP 直连验证全链路，再单次直接访问判断 DNS 传播状态。
    """
    time.sleep(3)
    if _pinned_check(url, timeout):
        return True, not _direct_check(url, 8)
    for _ in range(3):
        if _direct_check(url, timeout):
            return True, False
        time.sleep(3)
    return False, False


