def convert_md(text, title="文档"):
    """轻量 Markdown → HTML（标题/列表/表格/代码/链接/加粗等常用语法）。"""
    import html as _html

    def inline(t):
        t = _html.escape(t)
        t = re.sub(r"`([^`]+)`", r"<code>\1</code>", t)
        t = re.sub(r"!\[([^\]]*)\]\(([^)]+)\)", r'<img src="\2" alt="\1">', t)
        t = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r'<a href="\2">\1</a>', t)
        t = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", t)
        t = re.sub(r"\*([^*]+)\*", r"<em>\1</em>", t)
        return t

    lines = text.replace("\r\n", "\n").split("\n")
    out, i, para = [], 0, []
    def flush():
        if para:
            out.append("<p>%s</p>" % inline(" ".join(para)))
            para.clear()
    while i < len(lines):
        ln = lines[i]
        if ln.startswith("```"):
            flush()
            block = []
            i += 1
            while i < len(lines) and not lines[i].startswith("```"):
                block.append(lines[i]); i += 1
            out.append("<pre><code>%s</code></pre>" % _html.escape("\n".join(block)))
            i += 1; continue
        m = re.match(r"^(#{1,6})\s+(.*)$", ln)
        if m:
            flush()
            lvl = len(m.group(1))
            out.append("<h%d>%s</h%d>" % (lvl, inline(m.group(2)), lvl))
            i += 1; continue
        if re.match(r"^\s*([-*_])\s*\1\s*\1[\s\1]*$", ln):
            flush(); out.append("<hr>"); i += 1; continue
        if ln.startswith(">"):
            flush()
            quote = []
            while i < len(lines) and lines[i].startswith(">"):
                quote.append(lines[i].lstrip(">").strip()); i += 1
            out.append("<blockquote>%s</blockquote>" % inline(" ".join(quote)))
            continue
        if re.match(r"^\s*\|.*\|\s*$", ln) and i + 1 < len(lines) and \
                re.match(r"^\s*\|[\s:|-]+\|\s*$", lines[i + 1]):
            flush()
            header = [c.strip() for c in ln.strip().strip("|").split("|")]
            i += 2
            rows = []
            while i < len(lines) and re.match(r"^\s*\|.*\|\s*$", lines[i]):
                rows.append([c.strip() for c in lines[i].strip().strip("|").split("|")])
                i += 1
            out.append("<table><thead><tr>%s</tr></thead><tbody>%s</tbody></table>" % (
                "".join("<th>%s</th>" % inline(c) for c in header),
                "".join("<tr>%s</tr>" % "".join("<td>%s</td>" % inline(c) for c in r)
                        for r in rows)))
            continue
        if re.match(r"^\s*[-*+]\s+", ln):
            flush()
            items = []
            while i < len(lines) and re.match(r"^\s*[-*+]\s+", lines[i]):
                items.append("<li>%s</li>" % inline(re.sub(r"^\s*[-*+]\s+", "", lines[i])))
                i += 1
            out.append("<ul>%s</ul>" % "".join(items)); continue
        if re.match(r"^\s*\d+\.\s+", ln):
            flush()
            items = []
            while i < len(lines) and re.match(r"^\s*\d+\.\s+", lines[i]):
                items.append("<li>%s</li>" % inline(re.sub(r"^\s*\d+\.\s+", "", lines[i])))
                i += 1
            out.append("<ol>%s</ol>" % "".join(items)); continue
        if not ln.strip():
            flush(); i += 1; continue
        para.append(ln.strip()); i += 1
    flush()
    return """<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>%s</title><style>
body{font-family:-apple-system,'PingFang SC',sans-serif;max-width:820px;margin:40px auto;padding:0 24px;
color:#22312e;line-height:1.85;background:#f7f6f2}
h1,h2,h3{font-family:'Noto Serif SC','Songti SC',serif;line-height:1.4}
code{background:#ece9e2;border-radius:5px;padding:2px 6px;font-size:.92em}
pre{background:#1b211f;color:#a9c3ba;padding:16px;border-radius:10px;overflow-x:auto}
pre code{background:none;color:inherit;padding:0}
table{border-collapse:collapse;width:100%%;margin:14px 0;background:#fff}
th,td{border:1px solid #e0dcd2;padding:8px 12px;font-size:14px}
th{background:#e9f2ee}
blockquote{border-left:3px solid #b9975b;margin:12px 0;padding:6px 16px;background:#fff;color:#5c6b65}
img{max-width:100%%}a{color:#2a6558}
</style></head><body>%s</body></html>""" % (_html.escape(title), "\n".join(out))


def convert_xlsx(path, title="表格"):
    """xlsx → HTML 表格页（值提取，支持 sharedStrings / inlineStr）。"""
    import html as _html
    import xml.etree.ElementTree as ET
    z = zipfile.ZipFile(path)
    ns = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    shared = []
    if "xl/sharedStrings.xml" in z.namelist():
        root = ET.fromstring(z.read("xl/sharedStrings.xml"))
        for si in root.findall(ns + "si"):
            shared.append("".join(t.text or "" for t in si.iter(ns + "t")))
    parts = []
    sheets = sorted(n for n in z.namelist()
                    if n.startswith("xl/worksheets/sheet") and n.endswith(".xml"))
    for i, sn in enumerate(sheets):
        root = ET.fromstring(z.read(sn))
        rows = []
        for row in root.iter(ns + "row"):
            cells = []
            for c in row.iter(ns + "c"):
                t = c.get("t", "n")
                v = c.find(ns + "v")
                val = v.text if v is not None and v.text is not None else ""
                if t == "s" and val != "":
                    try:
                        val = shared[int(val)]
                    except (IndexError, ValueError):
                        pass
                elif t == "inlineStr":
                    is_el = c.find(ns + "is")
                    if is_el is not None:
                        val = "".join(x.text or "" for x in is_el.iter(ns + "t"))
                cells.append("<td>%s</td>" % _html.escape(str(val)))
            if cells:
                rows.append("<tr>%s</tr>" % "".join(cells))
        parts.append("<h2>%s</h2><table>%s</table>"
                     % (_html.escape("工作表 %d" % (i + 1)), "".join(rows)))
    body = "".join(parts) or "<p>空表格</p>"
    return """<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>%s</title><style>
body{font-family:-apple-system,'PingFang SC',sans-serif;max-width:960px;margin:40px auto;
padding:0 24px;color:#22312e;background:#f7f6f2}
h2{font-family:'Noto Serif SC',serif}
table{border-collapse:collapse;width:100%%;background:#fff;font-size:13.5px}
th,td{border:1px solid #e0dcd2;padding:7px 11px}
tr:first-child td,th{background:#e9f2ee;font-weight:600}
</style></head><body><h1>%s</h1>%s</body></html>""" % (
        _html.escape(title), _html.escape(title), body)


def build_site(src, staging, name):
    """把文件/文件夹整理成静态站点目录（md/xlsx 自动转 HTML）。"""
    import html as _html
    if os.path.isdir(staging):
        shutil.rmtree(staging)
    os.makedirs(staging, exist_ok=True)
    file_count = 0
    if os.path.isfile(src):
        ext = os.path.splitext(src)[1].lower()
        base = os.path.basename(src)
        if ext == ".md":
            with open(src, encoding="utf-8", errors="replace") as f:
                text = f.read()
            with open(os.path.join(staging, "index.html"), "w", encoding="utf-8") as f:
                f.write(convert_md(text, name or os.path.splitext(base)[0]))
            file_count += 1
        elif ext == ".xlsx":
            with open(os.path.join(staging, "index.html"), "w", encoding="utf-8") as f:
                f.write(convert_xlsx(src, name or os.path.splitext(base)[0]))
            shutil.copy2(src, os.path.join(staging, base))
            file_count += 2
        else:
            shutil.copy2(src, os.path.join(staging, "index" + ext if ext == ".html" else base))
            file_count += 1
        return file_count
    # 文件夹：整体拷贝 + md 转 html（同目录生成 .html 版本）
    for root, dirs, files in os.walk(src):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        rel = os.path.relpath(root, src)
        dst_root = staging if rel == "." else os.path.join(staging, rel)
        os.makedirs(dst_root, exist_ok=True)
        for name_f in files:
            if name_f.startswith("."):
                continue
            fp = os.path.join(root, name_f)
            dst = os.path.join(dst_root, name_f)
            ext = os.path.splitext(name_f)[1].lower()
            if ext == ".md":
                try:
                    with open(fp, encoding="utf-8", errors="replace") as f:
                        text = f.read()
                    with open(os.path.splitext(dst)[0] + ".html", "w", encoding="utf-8") as f:
                        f.write(convert_md(text, os.path.splitext(name_f)[0]))
                except OSError:
                    continue
            else:
                shutil.copy2(fp, dst)
            file_count += 1
    # 没有 index 时用第一个 html 顶上
    if not os.path.isfile(os.path.join(staging, "index.html")):
        htmls = sorted(f for f in os.listdir(staging) if f.endswith(".html"))
        if htmls:
            shutil.copy2(os.path.join(staging, htmls[0]),
                         os.path.join(staging, "index.html"))
    return file_count


def core_host(path=None, name=None, files=None):
    """部署静态站点到 GitHub Pages（关机可访问）。

    files: [{"path": 相对路径, "content_b64": …}]（来自控制台上传）；
    否则使用本地 path（文件夹或单文件）。
    """
    import base64
    if not gh_logged_in():
        raise PanwebError(2, "need_login", "GitHub 未登录",
                          "终端运行一次  gh auth login  即可激活云端托管")
    name = (name or "").strip() or (
        os.path.basename(path or "site").rsplit(".", 1)[0] or "site")
    slug = re.sub(r"[^a-z0-9-]+", "-", name.lower()).strip("-") or "site"
    stage = os.path.join(HOSTING_DIR, slug)
    os.makedirs(HOSTING_DIR, exist_ok=True)
    if files:
        if os.path.isdir(stage):
            shutil.rmtree(stage)
        os.makedirs(stage, exist_ok=True)
        for f in files:
            rel = f.get("path") or "index.html"
            rel = rel.replace("\\", "/").lstrip("/").replace("../", "")
            dst = os.path.join(stage, rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with open(dst, "wb") as f:
                f.write(base64.b64decode(f.get("content_b64") or ""))
        file_count = len(files)
    else:
        src = os.path.abspath(os.path.expanduser(path or ""))
        if not os.path.exists(src):
            raise PanwebError(2, "invalid_argument", "路径不存在：%s" % src)
        file_count = build_site(src, stage, name)

    repo = ("panweb-" + slug)[:60]
    # git 提交
    subprocess.run(["git", "init", "-b", "main"], cwd=stage, capture_output=True)
    subprocess.run(["git", "add", "."], cwd=stage, capture_output=True)
    subprocess.run(["git", "-c", "user.name=panweb", "-c",
                    "user.email=panweb@local", "commit", "-m", "deploy",
                    "--allow-empty"], cwd=stage, capture_output=True)
    _gh(["auth", "setup-git"])
    owner = _gh(["api", "user", "--jq", ".login"], check=True).stdout.strip()
    exists = _gh(["api", "repos/%s/%s" % (owner, repo),
                  "--jq", ".full_name"]).returncode == 0
    if not exists:
        out = _gh(["repo", "create", repo, "--public",
                   "--description", "panweb hosted site"])
        if out.returncode != 0:
            raise PanwebError(9, "host_failed", "创建仓库失败：" +
                              (out.stderr or out.stdout or "")[:300])
    remote = "https://github.com/%s/%s.git" % (owner, repo)
    subprocess.run(["git", "remote", "remove", "origin"], cwd=stage, capture_output=True)
    subprocess.run(["git", "remote", "add", "origin", remote], cwd=stage, capture_output=True)
    push = subprocess.run(["git", "push", "-f", "origin", "main"], cwd=stage,
                          capture_output=True, text=True, timeout=300)
    if push.returncode != 0:
        raise PanwebError(9, "host_failed", "推送失败：" + (push.stderr or "")[-300:])
    # 启用 Pages（已启用时 409，忽略）
    pages = _gh(["api", "-X", "POST", "repos/%s/%s/pages" % (owner, repo),
                 "-f", "source[branch]=main", "-f", "source[path]=/"])
    url = "https://%s.github.io/%s/" % (owner, repo)
    items = [h for h in load_hosted() if h["name"] != name]
    items.append({"name": name, "repo": repo, "url": url, "dir": stage,
                  "files": file_count,
                  "updated": time.strftime("%Y-%m-%d %H:%M:%S")})
    save_hosted(items)
    log_activity("publish", "云端托管了「%s」（%d 个文件，关机可访问）" % (name, file_count), url)
    return {"name": name, "repo": owner + "/" + repo, "url": url,
            "files": file_count,
            "note": "首次部署 GitHub 构建1-2 分钟，稍候刷新即可访问"}


def core_host_redeploy(name):
    items = [h for h in load_hosted() if h["name"] == name]
    if not items:
        raise PanwebError(2, "not_found", "没有找到托管项：%s" % name)
    stage = items[0].get("dir")
    if not stage or not os.path.isdir(stage):
        raise PanwebError(2, "not_found", "本地站点目录丢失，请重新托管")
    return core_host(stage, name=name)


