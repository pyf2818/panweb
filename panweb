def stop_entry(entry):
    fw = FORWARDERS.pop(entry.get("id"), None)
    if fw:
        fw.stop()
    for pid in [entry.get("pid"), entry.get("server_pid"), entry.get("app_pid")]:
        if pid and pid_alive(pid):
            try:
                os.killpg(os.getpgid(pid), signal.SIGTERM)
            except OSError:
                try:
                    os.kill(pid, signal.SIGTERM)
                except OSError:
                    pass


