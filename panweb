#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""panweb 薄启动器：把 src/ 加入模块路径，交给 panweb.cli。

实现位于 src/panweb/，按架构分层；本文件只负责找到包并启动。
App 打包时由 launcher 设置 PANWEB_RESOURCE_ROOT / PANWEB_ENTRYPOINT。
"""
import os
import sys

if sys.version_info < (3, 9):
    sys.stderr.write("panweb 需要 Python 3.9 或更高版本（当前 %s）。\n"
                     % sys.version.split()[0])
    sys.stderr.write("macOS 可运行 xcode-select --install，或安装 python.org 的 3.9+。\n")
    raise SystemExit(1)

ROOT = os.path.dirname(os.path.realpath(__file__))
SRC = os.path.join(ROOT, "src")
if SRC not in sys.path:
    sys.path.insert(0, SRC)

from panweb.cli import main

if __name__ == "__main__":
    main()
