def listening_ports():
    try:
        out = subprocess.run(
            ["lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-w"],
            capture_output=True, text=True, timeout=10,
        ).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    ports = {}
    for line in out.splitlines()[1:]:
        parts = line.split()
        if len(parts) < 9 or ":" not in parts[8]:
            continue
        addr = parts[8].rsplit(":", 1)
        try:
            port = int(addr[1])
            pid = int(parts[1]) if parts[1].isdigit() else None
        except ValueError:
            continue
        ports.setdefault(port, pid)
    return sorted(ports.items())


def probe_title(port):
    try:
        req = urllib.request.Request("http://127.0.0.1:%d/" % port,
                                     headers={"User-Agent": "panweb-discover"})
        body = urllib.request.urlopen(req, timeout=1.2).read(8192).decode("utf-8", "replace")
        m = re.search(r"<title[^>]*>(.*?)</title>", body, re.S | re.I)
        if m:
            return " ".join(m.group(1).split())[:80]
    except Exception:
        pass
    return None


def core_discover():
    results = []
    published_ports = {}
    for e in core_list():
        if e.get("kind") == "port":
            published_ports[e["target"]] = e["id"]
        elif e.get("kind") == "pages":
            published_ports[e.get("local_port")] = e["id"]
    for port, pid in listening_ports():
        title = probe_title(port)
        proc_name = None
        if pid:
            try:
                proc_name = subprocess.run(["ps", "-p", str(pid), "-o", "comm="],
                                           capture_output=True, text=True,
                                           timeout=5).stdout.strip()
                proc_name = os.path.basename(proc_name) if proc_name else None
            except Exception:
                pass
        if title is None and port not in KNOWN_PORTS:
            continue
        results.append({
            "port": port,
            "process": proc_name,
            "title": title or KNOWN_PORTS.get(port, "HTTP 服务"),
            "published": published_ports.get(port),
            "risky": is_risky_port(port),
        })
    return results


