def daemon_pid():
    try:
        with open(DAEMON_PID, "r", encoding="utf-8") as f:
            pid = int(f.read().strip())
        return pid if pid_alive(pid) else None
    except (OSError, ValueError):
        return None


def cmd_console(args):
    """控制台守护进程管理：panweb console start|stop"""
    if args.action == "start":
        running = daemon_pid()
        if running:
            url = "http://127.0.0.1:%d" % args.port
            if not args.json:
                print("✅ 控制台已在运行：%s（pid %d）" % (url, running))
            else:
                print(json.dumps({"ok": True, "data": {"url": url, "pid": running,
                                                       "already": True}},
                                 ensure_ascii=False))
            if args.open:
                open_browser(url)
            return
        script = os.path.realpath(__file__)
        logf = open(os.path.join(HOME_DIR, "ui-daemon.log"), "ab", buffering=0)
        proc = subprocess.Popen(
            [sys.executable, script, "ui", "--no-open", "--port", str(args.port)],
            stdout=logf, stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL, start_new_session=True)
        logf.close()
        deadline = time.time() + 8
        while time.time() < deadline and not port_listening(args.port):
            time.sleep(0.2)
        if not port_listening(args.port):
            emit_fail(PanwebError(9, "daemon_failed", "控制台启动失败",
                                  "查看日志：%s" % os.path.join(HOME_DIR, "ui-daemon.log")))
        with open(DAEMON_PID, "w", encoding="utf-8") as f:
            f.write(str(proc.pid))
        url = "http://127.0.0.1:%d" % args.port
        if args.open:
            open_browser(url)
        if args.json:
            print(json.dumps({"ok": True, "data": {"url": url, "pid": proc.pid}},
                             ensure_ascii=False))
        else:
            print("✅ 控制台已在后台运行：%s（pid %d，关闭终端不影响）" % (url, proc.pid))
            print("   停止：panweb console stop")
    else:
        pid = daemon_pid()
        if not pid:
            if args.json:
                print(json.dumps({"ok": True, "data": {"stopped": True, "was": None}},
                                 ensure_ascii=False))
            else:
                print("控制台当前没有在后台运行")
            return
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        deadline = time.time() + 5
        while pid_alive(pid) and time.time() < deadline:
            time.sleep(0.2)
        try:
            os.remove(DAEMON_PID)
        except OSError:
            pass
        if args.json:
            print(json.dumps({"ok": True, "data": {"stopped": True, "was": pid}},
                             ensure_ascii=False))
        else:
            print("✅ 控制台已停止（pid %d）" % pid)


