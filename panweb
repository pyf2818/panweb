        pass
    subprocess.Popen([bin_path], stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    return {"app": app, "binary": bin_path}


