class PanwebError(Exception):
    """带退出码与类型的业务错误，CLI 与 API 共用。"""

    def __init__(self, exit_code, err_type, message, hint=None):
        super().__init__(message)
        self.exit_code = exit_code
        self.err_type = err_type
        self.message = message
        self.hint = hint

    def to_dict(self):
        return {"ok": False, "error": {"type": self.err_type, "message": self.message,
                                       "exit_code": self.exit_code, "hint": self.hint}}


# ---------- 输出契约（CLI） ----------

def emit_ok(data, as_json):
    if as_json:
        print(json.dumps({"ok": True, "data": data}, ensure_ascii=False))
    return data


def emit_fail(err):
    if isinstance(err, PanwebError):
        print(json.dumps(err.to_dict(), ensure_ascii=False), file=sys.stderr)
        sys.exit(err.exit_code)
    print(json.dumps({"ok": False, "error": {"type": "internal_error",
                                             "message": str(err), "exit_code": 1}},
                     ensure_ascii=False), file=sys.stderr)
    sys.exit(1)


