class ProxyHandler(BaseHTTPRequestHandler):
    """内置代理：访问口令 + PV 记录 + 反向转发 / 只读静态服务。

    由 panweb 以子进程方式运行：
      panweb --internal-proxy --listen-port N (--target-port T | --serve-dir DIR) --entry-id ID
    """

    server_version = "panweb-proxy/1.0"

    def log_message(self, fmt, *args):
        pass

    # ---- 入口 ----
    def _handle(self):
        entry_id = self.server.entry_id
        pin = read_pin(entry_id)
        if pin and not self._authed(pin, entry_id):
            return self._gate(pin, entry_id)
        log_visit(entry_id, self.path, self.client_address[0],
                  self.headers.get("User-Agent"))
        if self.headers.get("Upgrade", "").lower() == "websocket":
            # 口令/统计代理模式暂不透传 WebSocket（默认直连模式不受影响）
            return self.send_error(501, "该应用经由口令代理发布，暂不支持 WebSocket；移除口令后重新发布即可")
        if self.server.serve_dir:
            return self._serve_static(self.server.serve_dir)
        return self._forward(self.server.target_host, self.server.target_port)

    do_GET = do_POST = do_HEAD = do_PUT = do_DELETE = do_PATCH = _handle

    # ---- 口令 ----
    def _authed(self, pin, entry_id):
        want = "panweb_auth=%s" % pin_token(entry_id, pin)
        return want in (self.headers.get("Cookie") or "")

    def _gate(self, pin, entry_id):
        if self.path.startswith("/__panweb/login") and self.command == "POST":
            length = int(self.headers.get("Content-Length") or 0)
            form = urllib.parse.parse_qs(self.rfile.read(length).decode("utf-8", "replace"))
            if form.get("pw", [""])[0] == pin:
                cookie = "panweb_auth=%s; Path=/; HttpOnly; Max-Age=604800" % pin_token(entry_id, pin)
                self.send_response(302)
                self.send_header("Set-Cookie", cookie)
                self.send_header("Location", "/")
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            self._login_page("口令不对，再试试")
            return
        if self.path.startswith("/__panweb/login"):
            return self._login_page("")
        self.send_response(302)
        self.send_header("Location", "/__panweb/login")
        self.send_header("Content-Length", "0")
        self.end_headers()

    def _login_page(self, err):
        body = LOGIN_PAGE.replace("__PANWEB_ERR__", err).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    # ---- 反向转发 ----
    def _forward(self, host, port):
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else None
        headers = {k: v for k, v in self.headers.items()
                   if k.lower() not in ("host", "connection", "keep-alive",
                                        "proxy-connection", "transfer-encoding", "upgrade")}
        headers["X-Forwarded-For"] = self.client_address[0]
        conn = http.client.HTTPConnection(host, port, timeout=120)
        try:
            conn.request(self.command, self.path, body=body, headers=headers)
            resp = conn.getresponse()
            self.send_response(resp.status, resp.reason)
            for k, v in resp.getheaders():
                if k.lower() in ("connection", "keep-alive", "transfer-encoding",
                                 "content-length"):
                    continue
                self.send_header(k, v)
            self.send_header("Connection", "close")
            self.end_headers()
            while True:
                chunk = resp.read(8192)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()  # SSE / 流式响应不缓冲
        except (OSError, http.client.HTTPException) as e:
            try:
                self.send_error(502, "应用暂时无响应（%s）" % e)
            except OSError:
                pass
        finally:
            conn.close()

    # ---- 只读静态服务 ----
    def _serve_static(self, root):
        if self.command == "POST":
            return self.send_error(403, "只读发布，不接受写入")
        rel = urllib.parse.unquote(urllib.parse.urlparse(self.path).path)
        fp = os.path.normpath(os.path.join(root, rel.lstrip("/")))
        if not fp.startswith(os.path.abspath(root)):
            return self.send_error(403)
        if os.path.isdir(fp):
            fp = os.path.join(fp, "index.html")
        if not os.path.isfile(fp):
            return self.send_error(404, "文件不存在")
        try:
            with open(fp, "rb") as f:
                data = f.read()
        except OSError:
            return self.send_error(404)
        mime = mimetypes.guess_type(fp)[0] or "application/octet-stream"
        if mime.startswith("text/") or mime in ("application/javascript", "application/json"):
            mime += "; charset=utf-8"
        self.send_response(200)
        self.send_header("Content-Type", mime)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)


def run_internal_proxy(listen_port, target_port, serve_dir, entry_id):
    """代理子进程入口（阻塞）。"""
    server = ThreadingHTTPServer(("127.0.0.1", listen_port), ProxyHandler)
    server.daemon_threads = True
    server.target_port = target_port
    server.target_host = "127.0.0.1"
    server.serve_dir = serve_dir
    server.entry_id = entry_id
    server.serve_forever()


# ---------- 扩展：本地转发器 + 隧道预热池（秒级发布） ----------

def _pipe(a, b):
    try:
        while True:
            data = a.recv(65536)
            if not data:
                break
            b.sendall(data)
    except OSError:
        pass
    finally:
        for s in (a, b):
            try:
                s.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass


class Forwarder:
    """本地 TCP 转发器：预热隧道的固定入口 → 实际应用端口。"""

    def __init__(self, listen_port):
        self.listen_port = listen_port
        self.dest_port = None
        self.server = None
        self.thread = None

    def start(self):
        parent = self

        class H(socketserver.BaseRequestHandler):
            def handle(self):
                if not parent.dest_port:
                    return
                try:
                    up = socket.create_connection(("127.0.0.1", parent.dest_port), timeout=10)
                except OSError:
                    return
                t = threading.Thread(target=_pipe, args=(up, self.request), daemon=True)
                t.start()
                _pipe(self.request, up)

        class S(socketserver.ThreadingTCPServer):
            allow_reuse_address = True
            daemon_threads = True

        self.server = S(("127.0.0.1", self.listen_port), H)
        self.thread = threading.Thread(target=self.server.serve_forever,
                                       daemon=True)
        self.thread.start()

    def retarget(self, dest_port):
        self.dest_port = dest_port

    def stop(self):
        try:
            self.server.shutdown()
        except OSError:
            pass


FORWARDERS = {}  # entry_id -> Forwarder（仅 ui 常驻进程内有意义）


class TunnelPool:
    """预热快速隧道：发布时直接取用，省去 10 秒等待。"""

    def __init__(self, cf_bin, size=1):
        self.cf = cf_bin
        self.size = size
        self.items = []
        self.lock = threading.Lock()

    def _spawn_one(self):
        listen_port = free_port()
        log_path = os.path.join(LOG_DIR, "pool-%s.log" % uuid.uuid4().hex[:6])
        url, proc = start_tunnel(self.cf, listen_port, log_path)
        item = {"port": listen_port, "url": url, "pid": proc.pid}
        fw = Forwarder(listen_port)
        fw.start()
        item["forwarder"] = fw
        return item

    def prewarm(self):
        def worker():
            while True:
                with self.lock:
                    missing = self.size - len(self.items)
                if missing <= 0:
                    return
                try:
                    item = self._spawn_one()
                except Exception:
                    time.sleep(30)
                    return
                with self.lock:
                    self.items.append(item)
        threading.Thread(target=worker, daemon=True).start()

    def acquire(self):
        with self.lock:
            if self.items:
                return self.items.pop(0)
        return None


CURRENT_POOL = None  # 仅 ui 常驻进程设置


def acquire_pooled_tunnel(port, entry_id=None):
    """控制台内优先用预热隧道（秒回）；返回 dict 或 None。"""
    if not CURRENT_POOL:
        return None
    item = CURRENT_POOL.acquire()
    if not item:
        return None
    item["forwarder"].retarget(port)
    if entry_id:
        FORWARDERS[entry_id] = item["forwarder"]
    CURRENT_POOL.prewarm()  # 立刻补充下一条
    return item


# ---------- 扩展：健康监控自愈 ----------

def entry_local_port(entry):
    """隧道回源指向的本地端口（代理端口或应用端口）。"""
    return entry.get("proxy_port") or entry.get("local_port") or entry.get("target")


def restart_entry_tunnel(entry):
    """重启一条发布的隧道（健康监控自愈用），返回新 url。"""
    cf = find_cloudflared()
    if not cf:
        raise PanwebError(3, "dependency_missing", "未找到 cloudflared")
    # 停掉旧隧道进程与旧转发器
    if pid_alive(entry.get("pid")):
        try:
            os.killpg(os.getpgid(entry["pid"]), signal.SIGTERM)
        except OSError:
            pass
    old_fw = FORWARDERS.pop(entry["id"], None)
    if old_fw:
        old_fw.stop()
    port = entry_local_port(entry)
    item = acquire_pooled_tunnel(port, entry["id"]) if CURRENT_POOL else None
    if item:
        url, pid = item["url"], item["pid"]
    else:
        log_path = os.path.join(LOG_DIR, "%s.log" % entry["id"])
        url, proc = start_tunnel(cf, port, log_path)
        pid = proc.pid
    entries = load_state()
    for e in entries:
        if e["id"] == entry["id"]:
            e["url"] = url
            e["pid"] = pid
    save_state(entries)
    return url


def _pinned_status(url, timeout):
    """边缘 IP 直连，返回 HTTP 状态码（0=无响应）。"""
    try:
        host = url.split("//", 1)[-1].split("/", 1)[0]
        edge = socket.getaddrinfo("trycloudflare.com", 443, socket.AF_INET)[0][4][0]
        out = subprocess.run(
            ["curl", "-s", "--resolve", "%s:443:%s" % (host, edge),
             "-o", "/dev/null", "-w", "%{http_code}", "--max-time", str(timeout), url],
            capture_output=True, text=True, timeout=timeout + 5,
        ).stdout.strip()
        return int(out) if out and out.isdigit() else 0
    except Exception:
        return 0


def entry_healthy(entry):
    """通道健康判定：502/530/无响应视为通道损坏；应用自身错误码不算。"""
    return _pinned_status(entry["url"], 6) not in (0, 502, 530)


def recover_all():
    """ui 启动时恢复上一进程遗留的池化条目（其转发器已随旧进程消亡）。"""
    sweep_expired()
    try:
        core_domain_recover()
    except Exception as e:  # noqa: BLE001
        log_activity("ui", "固定域名恢复失败：%s" % e)
    recovered = 0
    for entry in load_state():
        try:
            if entry.get("pooled"):
                url = restart_entry_tunnel(entry)
                entry["url"] = url
                recovered += 1
        except Exception as e:  # noqa: BLE001
            log_activity("ui", "「%s」启动恢复失败：%s" % (entry.get("name"), e))
    if recovered:
        log_activity("ui", "控制台重启，已恢复 %d 个发布的通道" % recovered)


def health_loop():
    """控制台内每 60 秒巡检：通道失联/死亡则自动重连并更新网址。

    遍历完整 state（不做 prune）——死亡条目正是最需要自愈的对象。
    本地服务没起（应用自己挂了）时不重启隧道，避免网址空转。
    """
    while True:
        time.sleep(60)
        write_menubar_state()
        if sweep_expired():
            continue
        for entry in load_state():
            try:
                if pid_alive(entry.get("pid")) and entry_healthy(entry):
                    continue
                if not port_listening(entry_local_port(entry)):
                    continue  # 应用未运行，等它起来
                url = restart_entry_tunnel(entry)
                entry["url"] = url
                log_activity("ui", "「%s」通道失联，已自动恢复" % entry["name"], url)
            except Exception as e:  # noqa: BLE001
                log_activity("ui", "「%s」自愈失败：%s" % (entry.get("name"), e))




# ---------- 扩展：时效链接 ----------

EXPIRES_PRESETS = {"1h": 3600, "1d": 86400, "7d": 604800}


def parse_expires(value):
    """'1h'/'1d'/'7d' → 时间戳；None/'' → None（永久）。非法值抛错。"""
    if not value:
        return None
    if value in EXPIRES_PRESETS:
        return time.time() + EXPIRES_PRESETS[value]
    try:
        ts = float(value)
        return ts if ts > time.time() else None
    except (TypeError, ValueError):
        raise PanwebError(2, "invalid_argument", "有效期需为 1h / 1d / 7d")


def sweep_expired():
    """收回已到期的发布（健康巡检与启动时调用）。"""
    now = time.time()
    swept = []
    for entry in load_state():
        exp = entry.get("expires_at")
        if exp and exp < now:
            stop_entry(entry)
            remaining = [e for e in load_state() if e["id"] != entry["id"]]
            save_state(remaining)
            meta = load_meta()
            meta["stopped_total"] = meta.get("stopped_total", 0) + 1
            save_json(META_FILE, meta)
            log_activity("stop", "「%s」已到期，自动收回" % entry["name"], entry.get("url"))
            swept.append(entry["name"])
