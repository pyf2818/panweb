class UiHandler(BaseHTTPRequestHandler):
    server_version = "panweb-ui/1.0"

    def log_message(self, fmt, *args):  # 静默访问日志
        pass

    # --- 响应工具 ---
    def send_json(self, obj, status=200):
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def api_error(self, err, status=None):
        if isinstance(err, PanwebError):
            self.send_json(err.to_dict(), status or (200 if err.exit_code != 1 else 500))
        else:
            self.send_json({"ok": False, "error": {"type": "internal_error",
                                                   "message": str(err)}}, 500)

    def read_body(self):
        length = int(self.headers.get("Content-Length") or 0)
        if length <= 0:
            return {}
        try:
            return json.loads(self.rfile.read(length).decode("utf-8"))
        except ValueError:
            return {}

    # --- 路由 ---
    def do_GET(self):
        path = self.path.split("?", 1)[0]
        try:
            if path in ("/", "/index.html"):
                return self.serve_index()
            if path == "/api/state":
                apps = core_list()
                for e in apps:
                    e["pv"] = aggregate_visits(e["id"])
                return self.send_json({"ok": True, "data": {
                    "doctor": core_doctor(),
                    "apps": apps,
                    "hosted": load_hosted(),
                    "stats": core_stats(),
                    "activity": list(reversed(load_activity()))[:20],
                }})
            if path == "/api/discover":
                return self.send_json({"ok": True, "data": {"candidates": core_discover()}})
            if path == "/api/detect":
                q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
                folder = (q.get("folder") or [""])[0]
                return self.send_json({"ok": True, "data": core_detect(folder)})
            if path == "/api/visits":
                q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
                entry_id = (q.get("id") or [""])[0]
                hours = min(int((q.get("hours") or ["24"])[0] or 24), 168)
                if not any(e["id"] == entry_id for e in core_list()):
                    return self.send_json({"ok": False, "error": {
                        "type": "not_found", "message": "应用不存在"}}, 200)
                return self.send_json({"ok": True,
                                       "data": aggregate_visits(entry_id, hours)})
            if path == "/api/log":
                q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
                entry_id = (q.get("id") or [""])[0]
                lines = min(int((q.get("lines") or ["80"])[0] or 80), 300)
                hits = [e for e in core_list() if e["id"] == entry_id]
                if not hits:
                    return self.send_json({"ok": False, "error": {
                        "type": "not_found", "message": "应用不存在"}}, 200)
                entry = hits[0]
                log_file = entry.get("app_log") or os.path.join(LOG_DIR, "%s.log" % entry_id)
                if not os.path.isfile(log_file):
                    log_file = os.path.join(LOG_DIR, "%s-proxy.log" % entry_id)
                try:
                    with open(log_file, "rb") as f:
                        data = f.read()[-16000:].decode("utf-8", "replace")
                    tail = data.splitlines()[-lines:]
                except OSError:
                    tail = []
                return self.send_json({"ok": True, "data": {
                    "log": tail, "file": log_file}})
            if path == "/api/agents":
                return self.send_json({"ok": True, "data": {"agents": core_agents()}})
            if path == "/api/system":
                return self.send_json({"ok": True, "data": core_system()})
            if path == "/api/domain":
                return self.send_json({"ok": True, "data": core_domain_status()})
            if path == "/api/install-cf/status":
                return self.send_json({"ok": True, "data": core_install_cf_status()})
            if path == "/api/doctor":
                return self.send_json({"ok": True, "data": core_doctor()})
            self.send_json({"ok": False, "error": {"type": "not_found",
                                                   "message": "未知路径 %s" % path}}, 404)
        except Exception as e:  # noqa: BLE001
            self.api_error(e)

    def do_POST(self):
        path = self.path.split("?", 1)[0]
        body = self.read_body()
        try:
            if path == "/api/publish":
                entry = core_publish(body.get("port"), body.get("name"),
                                     pin=(body.get("pin") or "").strip() or None,
                                     expires=body.get("expires"))
                return self.send_json({"ok": True, "data": entry})
            if path == "/api/pages":
                entry = core_pages(body.get("folder"), body.get("name"),
                                   pin=(body.get("pin") or "").strip() or None,
                                   expires=body.get("expires"))
                return self.send_json({"ok": True, "data": entry})
            if path == "/api/run":
                entry = core_run(body.get("folder"), body.get("name"))
                return self.send_json({"ok": True, "data": entry})
            if path == "/api/stop":
                stopped = core_stop(body.get("target") or "all")
                return self.send_json({"ok": True, "data": {"stopped": stopped}})
            if path == "/api/rename":
                entry_id, name = body.get("id"), (body.get("name") or "").strip()
                if not entry_id or not name:
                    return self.send_json({"ok": False, "error": {
                        "type": "invalid_argument", "message": "缺少 id 或新名称"}}, 200)
                entries = load_state()
                for e in entries:
                    if e["id"] == entry_id:
                        old = e["name"]
                        e["name"] = name
                        save_state(entries)
                        log_activity("ui", "「%s」改名为「%s」" % (old, name))
                        return self.send_json({"ok": True, "data": {"id": entry_id,
                                                                    "name": name}})
                return self.send_json({"ok": False, "error": {
                    "type": "not_found", "message": "应用不存在"}}, 200)
            if path == "/api/pin":
                entry_id, pin = body.get("id"), (body.get("pin") or "").strip()
                hits = [e for e in load_state() if e["id"] == entry_id]
                if not hits:
                    return self.send_json({"ok": False, "error": {
                        "type": "not_found", "message": "应用不存在"}}, 200)
                entry = hits[0]
                if len(pin) > 32:
                    return self.send_json({"ok": False, "error": {
                        "type": "invalid_argument", "message": "口令过长（≤32）"}}, 200)
                had_proxy = bool(entry.get("proxy_port"))
                if not had_proxy and pin:
                    # 端口直连 → 加口令需要改走代理：重新发布（网址会更新）
                    stop_entry(entry)
                    entries = [e for e in load_state() if e["id"] != entry_id]
                    save_state(entries)
                    new_entry = _publish_port(entry["target"], entry["name"], pin=pin)
                    log_activity("ui", "为「%s」设置了访问口令（网址已更新）"
                                 % entry["name"], new_entry["url"])
                    return self.send_json({"ok": True, "data": {
                        "updated": True, "entry": new_entry}})
                write_pin(entry_id, pin or None)
                if pin:
                    log_activity("ui", "为「%s」设置了访问口令" % entry["name"])
                else:
                    log_activity("ui", "「%s」的访问口令已移除" % entry["name"])
                return self.send_json({"ok": True, "data": {"updated": True,
                                                            "entry": entry}})
            if path == "/api/agents/connect":
                r = core_agent_connect(body.get("id"))
                return self.send_json({"ok": True, "data": r})
            if path == "/api/agents/disconnect":
                r = core_agent_disconnect(body.get("id"))
                return self.send_json({"ok": True, "data": r})
            if path == "/api/agents/guide":
                src = skill_source_dir()
                return self.send_json({"ok": True, "data": {
                    "guide": AGENT_GUIDE.format(src=src or "(未找到技能源，请先运行 install.sh)")}})
            if path == "/api/open":
                url = body.get("url")
                if not url:
                    return self.send_json({"ok": False, "error": {
                        "type": "invalid_argument", "message": "缺少 url"}}, 200)
                open_browser(url)
                return self.send_json({"ok": True, "data": {"opened": url}})
            if path == "/api/pack":
                return self.send_json({"ok": True, "data": core_pack(body.get("folder"))})
            if path == "/api/domain/login":
                return self.send_json({"ok": True, "data": core_domain_login()})
            if path == "/api/domain/setup":
                return self.send_json({"ok": True, "data": core_domain_setup(
                    body.get("domain"), body.get("name"))})
            if path == "/api/domain/bind":
                return self.send_json({"ok": True, "data": core_domain_bind(
                    body.get("id"))})
            if path == "/api/domain/teardown":
                return self.send_json({"ok": True, "data": core_domain_teardown()})
            if path == "/api/install-cf":
                return self.send_json({"ok": True, "data": core_install_cf()})
            if path == "/api/install-menubar":
                return self.send_json({"ok": True, "data": core_install_menubar()})
            if path == "/api/open-dir":
                p = os.path.abspath(os.path.expanduser(body.get("dir") or ""))
                if not p.startswith(HOME_DIR) or not os.path.isdir(p):
                    return self.send_json({"ok": False, "error": {
                        "type": "invalid_argument", "message": "目录不在数据目录内"}}, 200)
                open_browser(p)
                return self.send_json({"ok": True, "data": {"opened": p}})
            if path == "/api/recover":
                done = []
                for entry in load_state():
                    try:
                        url = restart_entry_tunnel(entry)
                        done.append({"id": entry["id"], "name": entry["name"], "url": url})
                    except Exception as e:  # noqa: BLE001
                        log_activity("ui", "「%s」手动恢复失败：%s" % (entry.get("name"), e))
                log_activity("ui", "手动重启了全部通道（%d 个）" % len(done))
                return self.send_json({"ok": True, "data": {"recovered": done}})
            if path == "/api/host":
                return self.send_json({"ok": True, "data": core_host(
                    body.get("path"), body.get("name"))})
            if path == "/api/host-upload":
                return self.send_json({"ok": True, "data": core_host(
                    None, body.get("name"), files=body.get("files"))})
            if path == "/api/host-redeploy":
                return self.send_json({"ok": True, "data": core_host_redeploy(
                    body.get("name"))})
            if path == "/api/shutdown":
                log_activity("ui", "控制台已停止（页面操作）")
                threading.Timer(0.6, lambda: os.kill(os.getpid(), signal.SIGTERM)).start()
                return self.send_json({"ok": True, "data": {"stopping": True}})
            self.send_json({"ok": False, "error": {"type": "not_found",
                                                   "message": "未知路径 %s" % path}}, 404)
        except PanwebError as e:
            self.api_error(e, status=200)  # 业务错误保持 200，前端按 ok 判断
        except Exception as e:  # noqa: BLE001
            self.api_error(e)

    def serve_index(self):
        path = ui_index_path()
        if not path:
            body = ("<h1>panweb 控制台</h1><p>缺少 ui/index.html，"
                    "请重新运行 install.sh。</p>").encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        with open(path, "rb") as f:
            body = f.read()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def cmd_ui(args):
    global CURRENT_POOL
    port = args.port
    doctor = core_doctor()
    log_activity("ui", "控制台已启动")
    write_menubar_state()
    server = ThreadingHTTPServer(("127.0.0.1", port), UiHandler)
    url = "http://127.0.0.1:%d" % port
    if doctor["ready"]:
        # 预热隧道池：控制台内发布秒级出网址；健康监控自愈每 60 秒巡检
        CURRENT_POOL = TunnelPool(doctor["cloudflared"], size=1)
        CURRENT_POOL.prewarm()
        threading.Thread(target=health_loop, daemon=True).start()
        threading.Thread(target=recover_all, daemon=True).start()
    if args.json:
        print(json.dumps({"ok": True, "data": {"url": url,
                                               "ready": doctor["ready"],
                                               "pool": bool(CURRENT_POOL)}},
                         ensure_ascii=False), flush=True)
    else:
        print("✅ 控制台已启动：%s（Ctrl+C 停止）" % url)
        print("   ⚡ 极速发布已就绪（预热隧道待命）" if CURRENT_POOL else "")
        if not doctor["ready"]:
            print("   ⚠️  cloudflared 未安装，发布功能不可用（brew install cloudflared）")
    if not args.no_open:
        open_browser(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n已停止控制台")
        log_activity("ui", "控制台已关闭")


